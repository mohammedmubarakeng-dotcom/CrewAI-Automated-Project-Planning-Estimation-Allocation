# ─────────────────────────────────────────────────────────────────────────────
# CrewAI Project Planner — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env in the project root:
#       cp .env.example .env
#
# 2. Fill in your real values below.
#
# 3. NEVER commit .env to version control — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Required — your OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional — override the default model (default: gpt-4o-mini)
# OPENAI_MODEL_NAME=gpt-4o-mini
